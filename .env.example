# --- Database ---
# Locally: leave as-is, docker-compose sets this for you.
# On Render: leave this out of the dashboard entirely — the render.yaml
# blueprint wires DATABASE_URL to your managed Postgres automatically.
DATABASE_URL=postgres://clm:change_me@db:5432/clmdb

# --- Local-only Postgres credentials (docker-compose reads these) ---
POSTGRES_USER=clm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=clmdb

# --- Google Gemini API (free tier, no credit card) ---
# Get a key from aistudio.google.com — sign in with any Google account
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- AWS S3 bucket (stands in for "shared folder" / "personal folder") ---
# Create one bucket with two prefixes used as folders:
#   shared/    -> shared_folder source
#   personal/  -> personal_folder source
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=clm-tool-documents
BUCKET_POLL_MINUTES=2

# --- SLA notifications ---
SLA_WARNING_DAYS=7
# Leave SMTP_HOST blank to just log notifications to the console instead of emailing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=clm-tool@example.com

# --- Feature toggles ---
ENABLE_WATCHER=true
ENABLE_SLA_CRON=true

PORT=3000
